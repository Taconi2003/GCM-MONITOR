<UserControl x:Class="GcmMonitor.App.Views.ResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GcmMonitor.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{Binding ResultStatus}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" />
          <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
      <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolVisibility}}">
        <UniformGrid Columns="4" Margin="0,2,0,8">
          <Border Style="{StaticResource Card}" BorderBrush="#23594F">
            <StackPanel>
              <TextBlock Text="{Binding NormalCount}" Foreground="#42D6B0" FontSize="27" />
              <TextBlock Text="Normal" Style="{StaticResource Muted}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" BorderBrush="#665334">
            <StackPanel>
              <TextBlock Text="{Binding AttentionCount}" Foreground="#FFC76A" FontSize="27" />
              <TextBlock Text="Atenção" Style="{StaticResource Muted}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" BorderBrush="#673649">
            <StackPanel>
              <TextBlock Text="{Binding FailureCount}" Foreground="#FF8292" FontSize="27" />
              <TextBlock Text="Falhas" Style="{StaticResource Muted}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{Binding UnavailableCount}" Foreground="#A3B7D1" FontSize="27" />
              <TextBlock Text="Indisponível" Style="{StaticResource Muted}" />
            </StackPanel>
          </Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Principais ocorrências" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding MainFindings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#2B4058" BorderThickness="0,0,0,1" Padding="0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Observation}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Interpretation}" Foreground="#FFC76A" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Resultados por módulo" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding ModuleResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander>
                    <Expander.Header>
                      <DockPanel>
                        <TextBlock Text="{Binding State}" Foreground="{Binding Color}" DockPanel.Dock="Right" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      </DockPanel>
                    </Expander.Header>
                    <StackPanel>
                      <TextBlock Text="{Binding Summary}" Margin="0,0,0,10" />
                      <TextBlock Text="{Binding Statistics}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                      <ItemsControl ItemsSource="{Binding EvidenceRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="#2B4058" BorderThickness="0,0,0,1" Padding="0,10" Margin="0,0,0,8">
                              <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Context}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,5" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Evidência" Foreground="{StaticResource CyanBrush}" />
                      <TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                      <TextBlock Text="Interpretação" Foreground="{StaticResource CyanBrush}" />
                      <TextBlock Text="{Binding Interpretation}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                      <TextBlock Text="Recomendação" Foreground="{StaticResource CyanBrush}" />
                      <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Ocorrências da coleta" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding CollectionIssues}" Style="{StaticResource Muted}" />
            <TextBlock Text="Falhas e indisponibilidades do coletor não comprovam defeito do computador." Foreground="#FFC76A" FontSize="11" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasProcessRankings, Converter={StaticResource BoolVisibility}}">
          <StackPanel>
            <TextBlock Text="Processos — Top 10 CPU acumulada" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding CpuProcesses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,6">
                    <TextBlock Text="{Binding Identity}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Values}" Style="{StaticResource Muted}" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Processos — Top 10 RAM média" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />
            <ItemsControl ItemsSource="{Binding MemoryProcesses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,6">
                    <TextBlock Text="{Binding Identity}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Values}" Style="{StaticResource Muted}" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <TextBlock Text="Gráficos: janela final de até 32 pontos por série. As estatísticas dos módulos abrangem os intervalos efetivamente observados da sessão." Style="{StaticResource Muted}" Margin="0,0,12,12" />
        <ItemsControl ItemsSource="{Binding ResultMetricCards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Width="320">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Component}" Style="{StaticResource Muted}" FontSize="11" />
                  <TextBlock Text="{Binding Unit}" Foreground="{StaticResource CyanBrush}" />
                  <local:MetricChart Values="{Binding Values}" Labels="{Binding Labels}" Unit="{Binding Unit}" AxisLabel="{Binding AxisLabel}" Height="140" Margin="0,12,0,8" />
                  <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="10" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Observações do técnico" Style="{StaticResource SectionTitle}" />
            <TextBox Text="{Binding TechnicianNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" MaxLength="10000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Observações do técnico" />
            <Button Content="Salvar observações" Command="{Binding SaveNotesCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Button Content="Exportar relatório PDF" Style="{StaticResource PrimaryButton}" IsEnabled="False" DockPanel.Dock="Right" Margin="20,0,0,0" />
          <StackPanel>
            <TextBlock Text="Exportação PDF indisponível na v0.3" FontWeight="SemiBold" />
            <TextBlock Text="Prevista para v1.0. A exportação PDF ainda não está implementada." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
