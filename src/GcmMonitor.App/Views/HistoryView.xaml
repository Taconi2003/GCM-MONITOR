<UserControl x:Class="GcmMonitor.App.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="170" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,14,0">
          <TextBlock Text="Computador" Style="{StaticResource Muted}" Margin="0,0,0,8" />
          <TextBox Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="Pesquisar computador" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,14,0">
          <TextBlock Text="Data · dd/MM/aaaa" Style="{StaticResource Muted}" Margin="0,0,0,8" />
          <TextBox Text="{Binding HistoryDateText, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Filtrar por data no formato dd/MM/aaaa" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Status" Style="{StaticResource Muted}" Margin="0,0,0,8" />
          <ComboBox ItemsSource="{Binding HistoryStatuses}" SelectedItem="{Binding HistoryStatus}" AutomationProperties.Name="Filtrar status" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,12,0">
      <StackPanel>
        <WrapPanel>
          <Button Content="Aplicar filtros" Command="{Binding ApplyHistoryFiltersCommand}" Margin="0,0,12,8" />
          <Button Content="Anterior" Command="{Binding PreviousHistoryCommand}" Margin="0,0,6,8" />
          <Button Content="Próxima" Command="{Binding NextHistoryCommand}" Margin="0,0,12,8" />
          <Button Content="Limpar histórico" Command="{Binding ClearHistoryCommand}" Style="{StaticResource DangerButton}" Margin="0,0,12,8" />
          <Button Content="Carregar exemplos fictícios" Command="{Binding LoadExamplesCommand}" Margin="0,0,0,8" Visibility="{Binding IsDemoMode, Converter={StaticResource BoolVisibility}}" />
        </WrapPanel>
        <TextBlock Text="{Binding HistoryPageLabel}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
        <TextBlock Text="{Binding StorageSummary}" Style="{StaticResource Muted}" FontSize="11" />
        <TextBlock Text="Exclusões pedem confirmação. PDFs externos e sessões ativas são preservados." Style="{StaticResource Muted}" FontSize="11" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="0">
      <Grid>
        <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#23374E" RowBackground="#101E33" AlternatingRowBackground="#122239" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" MinHeight="180">
          <DataGrid.Resources>
            <Style x:Key="TableText" TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              <Setter Property="TextWrapping" Value="Wrap" />
              <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#162B43" />
              <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
              <Setter Property="Padding" Value="14" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="DataGridCell">
              <Setter Property="Padding" Value="12,12" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#1B426D" />
                  <Setter Property="Foreground" Value="White" />
                </Trigger>
              </Style.Triggers>
            </Style>
            <Style TargetType="DataGridRow">
              <Setter Property="MinHeight" Value="55" />
            </Style>
          </DataGrid.Resources>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Data e hora" Binding="{Binding Date}" Width="145" ElementStyle="{StaticResource TableText}" />
            <DataGridTextColumn Header="Computador" Binding="{Binding Computer}" Width="*" MinWidth="190" ElementStyle="{StaticResource TableText}" />
            <DataGridTextColumn Header="Duração efetiva" Binding="{Binding Duration}" Width="145" ElementStyle="{StaticResource TableText}" />
            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="110" ElementStyle="{StaticResource TableText}" />
            <DataGridTemplateColumn Header="Ações" Width="220">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Abrir" Padding="9,6" Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="0,0,6,0" />
                    <Button Content="PDF" Padding="9,6" IsEnabled="False" ToolTip="Exportação prevista para v1.0" Margin="0,0,6,0" />
                    <Button Content="Excluir" Padding="9,6" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Visibility="{Binding HasNoHistory, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,70,24,24" IsHitTestVisible="False">
          <TextBlock Text="Nenhuma sessão encontrada" FontSize="20" HorizontalAlignment="Center" />
          <TextBlock Text="Inicie uma sessão ou revise os filtros." Style="{StaticResource Muted}" Margin="0,12,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
