<UserControl x:Class="GcmMonitor.App.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GcmMonitor.App.Controls">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Margin="0,8,12,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Setter Property="Padding" Value="14,10" />
          <Setter Property="BorderBrush" Value="#286088" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Iniciar diagnóstico" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" VerticalAlignment="Center" />
        <TextBlock Text="O GCM Monitor coleta e analisa informações do sistema. Não realiza alterações nas configurações, drivers ou no sistema operacional." Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <ItemsControl ItemsSource="{Binding Hardware}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <local:ResponsiveGrid MaximumColumns="5" MinimumTileWidth="190" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="12" MinHeight="122">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource CyanBrush}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Margin="0,6,0,4" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" LineHeight="15" />
                <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                        <ProgressBar Value="{Binding PercentUsed, Mode=OneWay}" Maximum="100" Height="3" Margin="0,4,0,7" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Style="{StaticResource Card}" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" BorderBrush="#277FAD">
        <StackPanel>
          <TextBlock Text="Uma sessão está em andamento" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding Clock}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,0,0,14" />
          <WrapPanel>
            <Button Content="Abrir monitoramento" Command="{Binding OpenMonitoringCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
            <Button Content="Cancelar diagnóstico" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Grid IsEnabled="{Binding CanConfigure}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="12">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="{Binding SelectedModuleCount, StringFormat={}{0} de 11}" DockPanel.Dock="Right" Foreground="{StaticResource CyanBrush}" />
              <TextBlock Text="Módulos de diagnóstico" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <WrapPanel Margin="0,0,0,12">
              <Button Content="Habilitar todos" Command="{Binding EnableAllCommand}" Style="{StaticResource PrimaryButton}" Padding="10,7" Margin="0,0,6,6" />
              <Button Content="Desabilitar todos" Command="{Binding DisableAllCommand}" Padding="10,8" Margin="0,0,6,6" />
              <Button Content="Restaurar padrão" Command="{Binding RestoreDefaultsCommand}" Padding="10,8" Margin="0,0,0,6" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Modules}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><local:ResponsiveGrid MaximumColumns="2" MinimumTileWidth="220" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#122C43" BorderBrush="#254963" BorderThickness="1" CornerRadius="8" Padding="8,0" Margin="0,0,6,5" MinHeight="42">
                      <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" ToolTip="{Binding Availability}" AutomationProperties.Name="{Binding Definition.Name}" Padding="0,5" VerticalAlignment="Center">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Definition.Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Definition.Name}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                          </StackPanel>
                        </Grid>
                      </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1">
          <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
              <TextBlock Text="Configurações do diagnóstico" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Duração do monitoramento" Style="{StaticResource Muted}" Margin="0,0,0,8" />
              <ListBox Style="{StaticResource DurationPicker}" ItemsSource="{Binding Durations}" DisplayMemberPath="ShortLabel" SelectedItem="{Binding MonitoringDuration}" AutomationProperties.Name="Duração do monitoramento" />
              <Border BorderBrush="#2B415A" BorderThickness="0,1,0,1" Margin="0,10" Padding="0,8">
                <StackPanel>
                  <CheckBox Content="Estresse da CPU" IsChecked="False" IsEnabled="False" />
                  <TextBlock Text="{Binding StressBlockReason}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,12" />
                  <ListBox Style="{StaticResource DurationPicker}" ItemsSource="{Binding Durations}" DisplayMemberPath="ShortLabel" SelectedItem="{Binding StressDuration}" IsEnabled="False" AutomationProperties.Name="Duração do estresse indisponível" />
                </StackPanel>
              </Border>
              <TextBlock Text="Discos físicos para análise" Style="{StaticResource Muted}" />
              <ItemsControl ItemsSource="{Binding Disks}" IsEnabled="{Binding StorageEnabled}" Margin="0,4,0,7">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" FontSize="12" Padding="0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox Content="Análise detalhada da bateria" IsChecked="{Binding DetailedBattery}" IsEnabled="{Binding BatteryEnabled}" Padding="0,4" />
              <CheckBox Content="Análise detalhada de Wi-Fi" IsChecked="{Binding DetailedWifi}" IsEnabled="{Binding WifiEnabled}" Padding="0,4" />
              <TextBlock Text="Sem medições ativas de rede nesta etapa." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Background="#10263A">
            <StackPanel>
              <TextBlock Text="Esta versão do Windows pode apresentar limitações em determinados diagnósticos. Alguns recursos podem não funcionar corretamente." Style="{StaticResource Muted}" FontSize="11" />
              <TextBlock Text="Sensores, SMART, bateria e Wi-Fi dependem de hardware, provedor e permissões. Ausência de leitura não comprova defeito físico." Foreground="#FFC76A" FontSize="11" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
