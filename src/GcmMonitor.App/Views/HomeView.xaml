<UserControl x:Class="GcmMonitor.App.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <ItemsControl ItemsSource="{Binding Hardware}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="5" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="14" MinHeight="160">
              <StackPanel>
                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="11" />
                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Margin="0,5,0,7" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="10" LineHeight="17" />
                <StackPanel Visibility="{Binding IsStorage, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                  <TextBlock Text="SSD · 62% ocupado" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                  <ProgressBar Value="62" Maximum="100" Height="3" Margin="0,4,0,7" />
                  <TextBlock Text="HDD · 28% ocupado" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                  <ProgressBar Value="28" Maximum="100" Height="3" Margin="0,4,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Style="{StaticResource Card}" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" BorderBrush="#277FAD">
        <StackPanel>
          <TextBlock Text="Uma demonstração está em andamento" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding Clock}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,0,0,14" />
          <WrapPanel>
            <Button Content="Abrir monitoramento" Command="{Binding OpenMonitoringCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
            <Button Content="Cancelar diagnóstico" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Grid IsEnabled="{Binding CanConfigure}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="{Binding SelectedModuleCount, StringFormat={}{0}/11}" DockPanel.Dock="Right" Foreground="{StaticResource CyanBrush}" />
              <TextBlock Text="Módulos de diagnóstico" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <WrapPanel Margin="0,0,0,12">
              <Button Content="Habilitar todos" Command="{Binding EnableAllCommand}" Padding="10,8" Margin="0,0,6,6" />
              <Button Content="Desabilitar todos" Command="{Binding DisableAllCommand}" Padding="10,8" Margin="0,0,6,6" />
              <Button Content="Restaurar padrão" Command="{Binding RestoreDefaultsCommand}" Padding="10,8" Margin="0,0,0,6" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Modules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#20344C" BorderThickness="0,0,0,1" Padding="0,3">
                    <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Definition.Name}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Definition.Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Definition.Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Definition.Code}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,2,0,0" VerticalAlignment="Center" />
                      </Grid>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Configurações do diagnóstico" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Duração do monitoramento" Style="{StaticResource Muted}" Margin="0,0,0,8" />
              <ComboBox ItemsSource="{Binding Durations}" DisplayMemberPath="Label" SelectedItem="{Binding MonitoringDuration}" AutomationProperties.Name="Duração do monitoramento" />
              <Border BorderBrush="#2B415A" BorderThickness="0,1,0,1" Margin="0,20" Padding="0,12">
                <StackPanel>
                  <CheckBox Content="Estresse da CPU" IsChecked="False" IsEnabled="False" />
                  <TextBlock Text="Desativado e bloqueado na v0.1. Requer supervisão e sensores de segurança validados na v0.4." Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,12" />
                  <ComboBox ItemsSource="{Binding Durations}" DisplayMemberPath="Label" SelectedItem="{Binding StressDuration}" IsEnabled="False" AutomationProperties.Name="Duração do estresse indisponível" />
                </StackPanel>
              </Border>
              <TextBlock Text="Discos físicos para análise" Style="{StaticResource Muted}" />
              <ItemsControl ItemsSource="{Binding Disks}" IsEnabled="{Binding StorageEnabled}" Margin="0,8,0,16">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" FontSize="12" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox Content="Análise detalhada da bateria" IsChecked="{Binding DetailedBattery}" IsEnabled="{Binding BatteryEnabled}" />
              <CheckBox Content="Análise detalhada de Wi-Fi" IsChecked="{Binding DetailedWifi}" IsEnabled="{Binding WifiEnabled}" />
              <TextBlock Text="Sem medições ativas de rede nesta etapa." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Background="#10263A">
            <StackPanel>
              <TextBlock Text="Esta versão do Windows pode apresentar limitações em determinados diagnósticos. Alguns recursos podem não funcionar corretamente." Style="{StaticResource Muted}" FontSize="11" />
              <TextBlock Text="Compatibilidade e sensores não validados em hardware real." Foreground="#FFC76A" FontSize="11" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,8,12,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Iniciar diagnóstico" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="20,0,0,0" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="O GCM Monitor coleta e analisa informações do sistema. Não realiza alterações nas configurações, drivers ou no sistema operacional." Style="{StaticResource Muted}" FontSize="11" />
            <TextBlock Text="Na v0.1, esta ação inicia somente a demonstração sintética." Foreground="{StaticResource CyanBrush}" FontSize="11" Margin="0,5,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>