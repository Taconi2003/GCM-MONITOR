<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/GcmMonitor.Core/GcmMonitor.Core.csproj" />
    <ProjectReference Include="../../src/GcmMonitor.Execution/GcmMonitor.Execution.csproj" />
    <Reference Include="LibreHardwareMonitorLib">
      <HintPath>$(SensorLibraryDirectory)/LibreHardwareMonitorLib.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireReviewedLibrary" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SensorLibraryDirectory)/LibreHardwareMonitorLib.dll')"
           Text="Use scripts/thermal-probe.ps1 com o arquivo oficial verificado. Esta ferramenta não faz parte do produto." />
  </Target>
  <Target Name="CopyReviewedDependencies" AfterTargets="Build">
    <ItemGroup><ReviewedDll Include="$(SensorLibraryDirectory)/*.dll" /></ItemGroup>
    <Copy SourceFiles="@(ReviewedDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
